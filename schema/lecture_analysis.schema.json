{
  "$defs": {
    "ActivityType": {
      "enum": [
        "explanation",
        "worked_example",
        "student_practice",
        "qa",
        "admin",
        "unclassified"
      ],
      "title": "ActivityType",
      "type": "string"
    },
    "Aspect": {
      "description": "Aspects of teaching and learning one lesson can show (``knowledge/framework``).",
      "enum": [
        "subject_knowledge",
        "lesson_planning",
        "questioning_dialogue",
        "challenge_support",
        "critical_thinking",
        "checking_understanding",
        "student_engagement",
        "student_interaction",
        "application_connections",
        "progress_in_lesson",
        "relationships_conduct"
      ],
      "title": "Aspect",
      "type": "string"
    },
    "AspectJudgement": {
      "properties": {
        "aspect": {
          "$ref": "#/$defs/Aspect"
        },
        "done_well": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Done Well"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRun"
          },
          "title": "Evidence",
          "type": "array"
        },
        "level": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "matched_descriptor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Descriptor"
        },
        "next_step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Step"
        },
        "reason_if_no_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason If No Level"
        },
        "supporting_finding_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supporting Finding Ids",
          "type": "array"
        }
      },
      "required": [
        "aspect",
        "level"
      ],
      "title": "AspectJudgement",
      "type": "object"
    },
    "Category": {
      "enum": [
        "content_error",
        "shortcoming",
        "conduct",
        "strength",
        "explanation_gap",
        "pedagogy"
      ],
      "title": "Category",
      "type": "string"
    },
    "ClassComposition": {
      "enum": [
        "co_ed",
        "girls",
        "boys",
        "unknown"
      ],
      "title": "ClassComposition",
      "type": "string"
    },
    "ClassType": {
      "enum": [
        "online",
        "in_person"
      ],
      "title": "ClassType",
      "type": "string"
    },
    "ConductSubtype": {
      "enum": [
        "shaming",
        "mocking",
        "dismissive",
        "gendered_language",
        "other"
      ],
      "title": "ConductSubtype",
      "type": "string"
    },
    "Confidence": {
      "enum": [
        "high",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Coverage": {
      "properties": {
        "not_covered_means": {
          "enum": [
            "gap",
            "not_in_this_lesson"
          ],
          "title": "Not Covered Means",
          "type": "string"
        },
        "objective_source": {
          "$ref": "#/$defs/ObjectiveSource"
        },
        "objectives": {
          "items": {
            "$ref": "#/$defs/Objective"
          },
          "minItems": 1,
          "title": "Objectives",
          "type": "array"
        },
        "objectives_reviewed": {
          "title": "Objectives Reviewed",
          "type": "boolean"
        },
        "summary_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/CoverageStatus"
          },
          "title": "Summary Counts",
          "type": "object"
        }
      },
      "required": [
        "objective_source",
        "objectives_reviewed",
        "not_covered_means",
        "objectives",
        "summary_counts"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "CoverageStatus": {
      "enum": [
        "covered",
        "partial",
        "not_covered",
        "deferred"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "EvidenceRun": {
      "description": "A run of contiguous transcript segments. Times and quote are resolved by code.",
      "properties": {
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Segment Ids",
          "type": "array"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "segment_ids",
        "start_ms",
        "end_ms",
        "quote"
      ],
      "title": "EvidenceRun",
      "type": "object"
    },
    "Finding": {
      "properties": {
        "aspect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Aspect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "claim_as_spoken": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim As Spoken"
        },
        "detector_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Detector Confidence",
          "type": "number"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRun"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "finding_id": {
          "pattern": "^f_[0-9a-f]{16}$",
          "title": "Finding Id",
          "type": "string"
        },
        "issue": {
          "title": "Issue",
          "type": "string"
        },
        "likely_intent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Likely Intent"
        },
        "metric_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Metric Refs",
          "type": "array"
        },
        "occurrences": {
          "default": 1,
          "minimum": 1,
          "title": "Occurrences",
          "type": "integer"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "subtype": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConductSubtype"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "suggested_rephrasing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Rephrasing"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        },
        "verifier_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Verifier Confidence",
          "type": "number"
        },
        "verifier_rationale": {
          "title": "Verifier Rationale",
          "type": "string"
        },
        "verifier_verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "what_the_phrasing_implies": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "What The Phrasing Implies"
        },
        "why_it_matters": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why It Matters"
        }
      },
      "required": [
        "finding_id",
        "category",
        "severity",
        "evidence",
        "segment_ids",
        "start_ms",
        "end_ms",
        "quote",
        "issue",
        "detector_confidence",
        "verifier_verdict",
        "verifier_confidence",
        "verifier_rationale"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingsSummary": {
      "properties": {
        "counts_by_category_and_severity": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "$ref": "#/$defs/Severity"
            },
            "type": "object"
          },
          "propertyNames": {
            "$ref": "#/$defs/Category"
          },
          "title": "Counts By Category And Severity",
          "type": "object"
        },
        "released_categories": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Category"
          },
          "title": "Released Categories",
          "type": "array"
        }
      },
      "required": [
        "counts_by_category_and_severity"
      ],
      "title": "FindingsSummary",
      "type": "object"
    },
    "LectureNotes": {
      "description": "Notes for students. ``source`` \"pipeline\" is the generated draft (always\n``draft_requires_teacher_approval``); \"teacher\" is the teacher's saved version, which only\nthe teacher can edit and approve. A teacher version whose cited segments no longer exist\nafter a rerun is kept, flagged ``stale`` with a reason, never silently trimmed.",
      "properties": {
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "edited_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Edited At"
        },
        "markdown": {
          "title": "Markdown",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/NoteSection"
          },
          "title": "Sections",
          "type": "array"
        },
        "source": {
          "default": "pipeline",
          "enum": [
            "pipeline",
            "teacher"
          ],
          "title": "Source",
          "type": "string"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        },
        "stale_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale Reason"
        },
        "status": {
          "$ref": "#/$defs/NotesStatus"
        }
      },
      "required": [
        "status",
        "sections",
        "markdown"
      ],
      "title": "LectureNotes",
      "type": "object"
    },
    "LessonJudgement": {
      "description": "One entry per aspect, in ``Aspect`` order. No overall grade: one lesson cannot show\nthe school-level evidence an overall judgement needs.",
      "properties": {
        "aspects": {
          "items": {
            "$ref": "#/$defs/AspectJudgement"
          },
          "minItems": 1,
          "title": "Aspects",
          "type": "array"
        }
      },
      "required": [
        "aspects"
      ],
      "title": "LessonJudgement",
      "type": "object"
    },
    "Level": {
      "description": "Six-level lesson judgement, best first; ``good`` is the expected level.",
      "enum": [
        "outstanding",
        "very_good",
        "good",
        "acceptable",
        "weak",
        "very_weak"
      ],
      "title": "Level",
      "type": "string"
    },
    "Metadata": {
      "properties": {
        "board": {
          "title": "Board",
          "type": "string"
        },
        "chapter": {
          "title": "Chapter",
          "type": "string"
        },
        "class_composition": {
          "$ref": "#/$defs/ClassComposition"
        },
        "class_type": {
          "$ref": "#/$defs/ClassType"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "grade": {
          "title": "Grade",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "teacher_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Teacher Id"
        }
      },
      "required": [
        "board",
        "grade",
        "subject",
        "chapter",
        "class_type",
        "class_composition",
        "duration_ms"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "MetricResult": {
      "description": "A scalar metric. Missing data is ``value=None`` with a reason, never 0 or 100.",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "data_source": {
          "title": "Data Source",
          "type": "string"
        },
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "kind": {
          "const": "scalar",
          "default": "scalar",
          "title": "Kind",
          "type": "string"
        },
        "reason_if_null": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason If Null"
        },
        "reason_low_confidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Low Confidence"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "unit",
        "definition",
        "data_source",
        "confidence",
        "value"
      ],
      "title": "MetricResult",
      "type": "object"
    },
    "NoteBullet": {
      "properties": {
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Segment Ids",
          "type": "array"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "segment_ids"
      ],
      "title": "NoteBullet",
      "type": "object"
    },
    "NoteSection": {
      "properties": {
        "bullets": {
          "items": {
            "$ref": "#/$defs/NoteBullet"
          },
          "minItems": 1,
          "title": "Bullets",
          "type": "array"
        },
        "heading": {
          "title": "Heading",
          "type": "string"
        }
      },
      "required": [
        "heading",
        "bullets"
      ],
      "title": "NoteSection",
      "type": "object"
    },
    "NotesStatus": {
      "enum": [
        "draft_requires_teacher_approval",
        "approved"
      ],
      "title": "NotesStatus",
      "type": "string"
    },
    "Objective": {
      "properties": {
        "evidence_segment_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Segment Ids",
          "type": "array"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CoverageStatus"
        }
      },
      "required": [
        "objective",
        "status"
      ],
      "title": "Objective",
      "type": "object"
    },
    "ObjectiveSource": {
      "enum": [
        "lesson_plan",
        "syllabus",
        "teacher_stated",
        "model_knowledge"
      ],
      "title": "ObjectiveSource",
      "type": "string"
    },
    "Problem": {
      "properties": {
        "concepts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Concepts",
          "type": "array"
        },
        "learning_objective": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Learning Objective"
        },
        "problem_text": {
          "title": "Problem Text",
          "type": "string"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Segment Ids",
          "type": "array"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ProblemStatus"
        }
      },
      "required": [
        "problem_text",
        "segment_ids",
        "start_ms",
        "status"
      ],
      "title": "Problem",
      "type": "object"
    },
    "ProblemStatus": {
      "enum": [
        "solved",
        "assigned",
        "deferred",
        "unknown"
      ],
      "title": "ProblemStatus",
      "type": "string"
    },
    "Quality": {
      "properties": {
        "asr_provider": {
          "title": "Asr Provider",
          "type": "string"
        },
        "diarization_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diarization Confidence"
        },
        "diarization_method": {
          "title": "Diarization Method",
          "type": "string"
        },
        "mean_asr_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Asr Confidence"
        },
        "names_redacted": {
          "title": "Names Redacted",
          "type": "boolean"
        },
        "teacher_id_method": {
          "title": "Teacher Id Method",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "asr_provider",
        "diarization_method",
        "teacher_id_method",
        "names_redacted"
      ],
      "title": "Quality",
      "type": "object"
    },
    "Section": {
      "properties": {
        "activity_type": {
          "$ref": "#/$defs/ActivityType"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "first_segment_id": {
          "title": "First Segment Id",
          "type": "string"
        },
        "last_segment_id": {
          "title": "Last Segment Id",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "first_segment_id",
        "last_segment_id",
        "start_ms",
        "end_ms",
        "activity_type"
      ],
      "title": "Section",
      "type": "object"
    },
    "Segment": {
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "lang_tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Lang Tags",
          "type": "array"
        },
        "segment_id": {
          "pattern": "^s\\d{4,}$",
          "title": "Segment Id",
          "type": "string"
        },
        "speaker": {
          "$ref": "#/$defs/Speaker"
        },
        "speaker_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker Label"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "text_asr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Asr"
        },
        "words": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Word"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "segment_id",
        "start_ms",
        "end_ms",
        "speaker",
        "text"
      ],
      "title": "Segment",
      "type": "object"
    },
    "SeriesResult": {
      "description": "A time series binned over the full lecture ``[0, duration_ms]``; empty bins are None.",
      "properties": {
        "bin_ms": {
          "exclusiveMinimum": 0,
          "title": "Bin Ms",
          "type": "integer"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "data_source": {
          "title": "Data Source",
          "type": "string"
        },
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
